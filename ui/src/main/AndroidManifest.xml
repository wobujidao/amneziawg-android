<?xml version="1.0" encoding="utf-8"?>
<!-- Modified 2026 by Mayak Networks. SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- READ_PHONE_STATE УБРАНО 2026-07-31 (решение владельца от 29-07 «только на бету, перед релизом
         убрать» + аудит 07-31). Кроме позиционирования была и вторая причина: разрешение НЕ РАБОТАЛО —
         диалог не показывался ни разу (запрос улетал поверх запроса уведомлений, а флаг «уже спросили»
         ставился до показа), так что тип радиосети в диагностику всё равно не попадал. Приложение при
         этом числилось в группе «Телефон» в настройках и в карточке Play. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- уведомление «Подключено» (флаг+направление), API 33+ требует runtime-разрешения -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- самообновление (Вариант Б): установка скачанного APK из приложения -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        android:minSdkVersion="34" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <permission
        android:name="${applicationId}.permission.CONTROL_TUNNELS"
        android:description="@string/permission_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/permission_label"
        android:protectionLevel="dangerous" />

    <application
        android:name=".Application"
        android:allowBackup="false"
        android:banner="@mipmap/banner"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".activity.TunnelToggleActivity"
            android:excludeFromRecents="true"
            android:theme="@style/NoBackgroundTheme" />

        <!-- Экран «Маяк» — точка входа приложения (бета MVP).
             Настройки плитки быстрых настроек ведут СЮДА (QS_TILE_PREFERENCES): раньше этот фильтр
             стоял на апстримном экране amnezia, из-за чего тот был exported и открывался снаружи. -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/MayakTheme">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Маскировка приложения (SPEC-0018 F2): лаунчер-запись вынесена в activity-alias, чтобы
             можно было переключать иконку+имя, не трогая саму MayakActivity. Ровно ОДИН alias enabled
             в любой момент (MayakDisguise.apply через setComponentEnabledSetting). По умолчанию Default —
             наследует иконку приложения (ic_launcher) и имя «Маяк», т.е. выглядит как сейчас. Имена
             алиасов ПОЛНЫЕ (не относительные): в debug applicationId = <pkg>.debug ≠ namespace, а имя
             компонента строится от namespace → ComponentName(packageName, ПОЛНОЕ_имя) совпадёт. -->
        <activity-alias
            android:name="org.amnezia.awg.mayak.disguise.Default"
            android:targetActivity="org.amnezia.awg.mayak.MayakActivity"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Светлый вариант «Mayak» (тот же маяк на белом фоне). Имя на экране остаётся «Mayak Networks»;
             в диалоге выбора иконок помечен как «Mayak (светлый)». -->
        <activity-alias
            android:name="org.amnezia.awg.mayak.disguise.MayakLight"
            android:targetActivity="org.amnezia.awg.mayak.MayakActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_disguise_mayak_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="org.amnezia.awg.mayak.disguise.Weather"
            android:targetActivity="org.amnezia.awg.mayak.MayakActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_disguise_weather"
            android:label="@string/mayak_disguise_weather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="org.amnezia.awg.mayak.disguise.Notes"
            android:targetActivity="org.amnezia.awg.mayak.MayakActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_disguise_notes"
            android:label="@string/mayak_disguise_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="org.amnezia.awg.mayak.disguise.Calc"
            android:targetActivity="org.amnezia.awg.mayak.MayakActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_disguise_calc"
            android:label="@string/mayak_disguise_calc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Экран настроек «Маяк»: тема + язык + «О приложении» -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakSettingsActivity"
            android:exported="false"
            android:label="@string/mayak_settings"
            android:theme="@style/MayakTheme" />

        <!-- Экран «Поддержка» (08-08): форма обращения в ядро вместо mailto:, свои обращения,
             запасные пути (адрес в буфер, письмо, справка). adjustResize — поле ввода длинное,
             и клавиатура не должна накрывать кнопку «Отправить». -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakSupportActivity"
            android:exported="false"
            android:label="@string/mayak_support_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/MayakTheme" />

        <!-- Переписка по обращению: ответы поддержки и «дописать» -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakSupportThreadActivity"
            android:exported="false"
            android:label="@string/mayak_support_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/MayakTheme" />

        <!-- Экран «Сообщения» (SPEC-0047): ящик сообщений от нас — чеки, срок доступа, ответы
             поддержки, приглашения. singleTop: тап по уведомлению при уже открытом экране обязан
             показать ТУ карточку (onNewIntent), а не положить сверху вторую копию экрана. -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakMessagesActivity"
            android:exported="false"
            android:label="@string/mayak_messages_title"
            android:launchMode="singleTop"
            android:theme="@style/MayakTheme" />

        <!-- Регистрация ПРЯМО В ПРИЛОЖЕНИИ (SPEC-0048): пароль, согласие, проверка «вы человек» в
             WebView, показ номера аккаунта. НЕ exported: запустить её снаружи не должно быть
             возможно — иначе любое приложение на телефоне могло бы показать человеку наш экран с
             полем пароля. adjustResize — под полем стоит чекбокс согласия и кнопка, и клавиатура не
             имеет права их накрыть (без согласия кнопка не активна, а он бы её не увидел). -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakRegisterActivity"
            android:exported="false"
            android:label="@string/mayak_reg_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/MayakTheme" />

        <!-- Экран «О приложении»: версия, на чём основано, лицензии -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakAboutActivity"
            android:exported="false"
            android:label="@string/mayak_about"
            android:theme="@style/MayakTheme" />

        <!-- Редактор пресета сплит-туннеля (SPEC-0028): полноэкранный, имя+режим+список приложений -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakPresetEditorActivity"
            android:exported="false"
            android:label="@string/mayak_preset_editor_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/MayakTheme" />

        <!-- Экран блокировки приложения (биометрия/PIN): показывается ПОВЕРХ главной. excludeFromRecents —
             не мелькает отдельной задачей в превью; FLAG_SECURE ставится в коде (скрывает превью/скриншот). -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/MayakTheme" />

        <!-- Экран отрезанной сборки (порог min_version_code): показывается ПОВЕРХ главной и не
             отменяется. НЕ exported: запустить его снаружи не должно быть возможно — иначе любое
             приложение на телефоне могло бы показать человеку «ваша версия больше не работает». -->
        <activity
            android:name="org.amnezia.awg.mayak.MayakOutdatedActivity"
            android:exported="false"
            android:theme="@style/MayakTheme" />

        <!-- Стоковый экран amnezia оставлен (импорт/диагностика), но не лаунчер и НЕ exported.
             Ревью 2026-07-07 п. 5 и аудит 2026-07-31 п. 13: он был открыт наружу, и любое приложение
             на телефоне могло его запустить — человек видел под нашим заголовком чужой логотип
             AmneziaWG «W», список туннелей и предложение импортировать произвольный конфиг. Для
             продукта, который публично не VPN, это раскрытие и чужой бренд одним intent'ом. -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activity.TvMainActivity"
            android:exported="true"
            android:theme="@style/TvTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.SettingsActivity"
            android:label="@string/settings"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name=".activity.TunnelCreatorActivity"
            android:label="@string/create_activity_title"
            android:parentActivityName=".activity.MainActivity" />

        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <activity
            android:name=".activity.LogViewerActivity"
            android:exported="false"
            android:label="@string/log_viewer_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <provider
            android:name=".activity.LogViewerActivity$ExportedLogContentProvider"
            android:authorities="${applicationId}.exported-log"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- FileProvider для скачанного APK (самообновление, Вариант Б) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mayak_update_paths" />
        </provider>

        <receiver
            android:name=".BootShutdownReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".model.TunnelManager$IntentReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.CONTROL_TUNNELS">
            <intent-filter>
                <action android:name="org.amnezia.awg.action.REFRESH_TUNNEL_STATES" />
                <action android:name="org.amnezia.awg.action.SET_TUNNEL_UP" />
                <action android:name="org.amnezia.awg.action.SET_TUNNEL_DOWN" />
            </intent-filter>
        </receiver>

        <!-- кнопка «Отключить» в уведомлении «Подключено» (Mayak) -->
        <receiver
            android:name="org.amnezia.awg.mayak.MayakNotificationReceiver"
            android:exported="false" />

        <!-- Плитка в шторке. Апстримная (.QuickTileService) умеет только туннели из TunnelManager,
             которых у нас нет: конфиг приходит из /connect и живёт в GoTunnel, поэтому её тап уводил
             бы в апстримный UI со списком туннелей. Регистрируем свою — она поднимает/гасит именно
             наш туннель. Класс апстрима оставлен в коде (на него ссылается его же экран настроек). -->
        <service
            android:name="org.amnezia.awg.mayak.MayakQuickTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_stat_mayak"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Приём пуша (ускоритель ящика SPEC-0047). Пуш приходит ТОЛЬКО с данными и БЕЗ текста —
             «загляни в ящик»; уведомление рисует приложение из ящика (MayakPushService).
             exported="false" — снаружи будить эту службу не должен никто, кроме транспорта, который
             ходит по своему разрешению. Работает лишь в боевой сборке: конфигурация Firebase лежит
             строковыми ресурсами только в варианте prodRelease, без них FirebaseApp не поднимается и
             служба просто никогда не вызывается (см. MayakPush.available). -->
        <service
            android:name="org.amnezia.awg.mayak.MayakPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <!-- Сохраняет выбранную в приложении локаль между запусками (in-app language picker) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Видимость браузера для открытия кабинета/политики/условий (https) на Android 11+ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
