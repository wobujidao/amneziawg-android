<?xml version="1.0" encoding="utf-8"?>
<!-- Знакомство: показывается ОДИН раз, при первом входе, до первого подключения. Три коротких
     карточки — что это, как включить, как сменить страну. Больше не показывается никогда.
     Почему листом, а не отдельным экраном с пролистыванием: у нас уже есть один такой лист
     (постоянное подключение), человек его узнаёт, и на три абзаца заводить целый экран с точками
     и кнопкой «Далее» — лишний обряд. Правило показа — core.Onboarding (под юнит-тестом).
     ⚠️ Про постоянное подключение здесь НАРОЧНО ни слова: этот разговор случается позже, после
     первого удачного коннекта, и дублировать его тут значит утопить оба. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mayak_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/mayak_space_6"
        android:paddingEnd="@dimen/mayak_space_6"
        android:paddingTop="@dimen/mayak_screen_top"
        android:paddingBottom="@dimen/mayak_space_6">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/mayak_space_4"
            android:background="@drawable/mayak_sheet_grabber" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/mayak_space_4"
            android:text="@string/mayak_onboarding_title"
            android:textColor="@color/mayak_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Карточка 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mayak_onboarding_1_title"
            android:textColor="@color/mayak_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_card_title_gap"
            android:layout_marginBottom="@dimen/mayak_space_4"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/mayak_onboarding_1_text"
            android:textAppearance="@style/Mayak.Tagline"
            android:textColor="@color/mayak_on_bg_muted" />

        <!-- Карточка 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mayak_onboarding_2_title"
            android:textColor="@color/mayak_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_card_title_gap"
            android:layout_marginBottom="@dimen/mayak_space_4"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/mayak_onboarding_2_text"
            android:textAppearance="@style/Mayak.Tagline"
            android:textColor="@color/mayak_on_bg_muted" />

        <!-- Карточка 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mayak_onboarding_3_title"
            android:textColor="@color/mayak_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_card_title_gap"
            android:layout_marginBottom="@dimen/mayak_space_4"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/mayak_onboarding_3_text"
            android:textAppearance="@style/Mayak.Tagline"
            android:textColor="@color/mayak_on_bg_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_onboarding_done"
            style="@style/Mayak.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mayak_onboarding_done" />
    </LinearLayout>
</ScrollView>
