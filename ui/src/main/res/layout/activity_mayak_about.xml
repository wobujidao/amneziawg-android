<?xml version="1.0" encoding="utf-8"?>
<!-- «О приложении»: версия, на чём основано (AmneziaWG / amneziawg-go / протокол 3.0),
     лицензия, открытый код, стабы политики/условий. Брендовый Material 3, DayNight. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mayak_bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mayak_about_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/mayak_screen_h"
            android:paddingEnd="@dimen/mayak_screen_h"
            android:paddingTop="@dimen/mayak_screen_top"
            android:paddingBottom="@dimen/mayak_screen_bottom">

            <!-- Логотип + название + версия -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/mayak_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_2"
                        android:text="@string/app_name"
                        android:textAppearance="@style/Mayak.CardTitle"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/mayak_tagline"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface_muted" />

                    <TextView
                        android:id="@+id/mayak_about_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_2"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface_muted"
                        tools:ignore="HardcodedText"
                        android:text="v—" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Основано на -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mayak_based_on"
                        android:textAppearance="@style/Mayak.CardTitle" />

                    <TextView
                        android:id="@+id/mayak_about_basedon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_card_title_gap"
                        android:lineSpacingMultiplier="1.2"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface"
                        tools:ignore="HardcodedText"
                        android:text="—" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Лицензия + открытый код -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mayak_license"
                        android:textAppearance="@style/Mayak.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_card_title_gap"
                        android:lineSpacingMultiplier="1.2"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface"
                        android:text="@string/mayak_license_line" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_about_oss"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_3"
                        app:icon="@drawable/ic_action_open"
                        app:iconGravity="textStart"
                        app:iconTint="@color/mayak_outline"
                        android:text="@string/mayak_oss_licenses" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Правовое (стабы) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- hyphenationFrequency: на крупном системном шрифте (200 %) слово
                         «конфиденциальности» шире кнопки и рвалось по буквам (замер 15-08);
                         с дефисацией перенос читаемый. На обычном шрифте не влияет. -->
                    <!-- Раскрытие «что мы собираем» ВНУТРИ приложения — стоит первым: политику
                         открывает браузер, а этот экран читается всегда, даже когда сеть режут. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_about_data"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hyphenationFrequency="normal"
                        app:iconGravity="textStart"
                        android:text="@string/mayak_data_link" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_about_privacy"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_2"
                        android:hyphenationFrequency="normal"
                        app:iconGravity="textStart"
                        android:text="@string/mayak_privacy_policy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_about_terms"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_2"
                        app:iconGravity="textStart"
                        android:text="@string/mayak_terms" />

                    <!-- Кнопка «Удалить аккаунт» переехала в «Настройки» — к email аккаунта и «Выйти»
                         (аудит 2026-07-31, п. 16). Здесь она стояла в разделе документов и вела на
                         сайт, поэтому человек, искавший удаление там, где живёт аккаунт, её не находил.
                         Google Play (с 15.04.2024) требует путь удаления И в приложении, И по
                         веб-ссылке: в приложении он теперь настоящий, веб-путь остался в кабинете. -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Шапка ЗАКРЕПЛЕНА поверх прокрутки — тем же приёмом, что в «Настройках» (аудит 2026-07-31,
         п. 8). Здесь она ехала вместе с контентом, и на Android 15 это стало видно в упор: система
         с targetSdk 35 рисует экран ОТ КРАЯ ДО КРАЯ, статус-бар прозрачен — заголовок «О приложении»
         оказывался ровно под часами (замер на эмуляторе 15-08). Фон непрозрачный и равен ВЕРХНЕМУ
         цвету градиента, поэтому стыка не видно, а уезжающий текст прячется под шапкой. -->
    <LinearLayout
        android:id="@+id/mayak_about_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:background="@color/mayak_bg_grad_top"
        android:elevation="4dp"
        android:paddingStart="@dimen/mayak_space_2"
        android:paddingEnd="@dimen/mayak_screen_h"
        android:paddingTop="@dimen/mayak_space_1"
        android:paddingBottom="@dimen/mayak_space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_about_back"
            style="@style/Mayak.Button.Text.Icon48"
            android:contentDescription="@string/mayak_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/mayak_on_bg"
            app:iconSize="@dimen/mayak_icon"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mayak_space_2"
            android:text="@string/mayak_about"
            android:textAppearance="@style/Mayak.Title"
            android:textSize="24sp" />
    </LinearLayout>
</FrameLayout>
