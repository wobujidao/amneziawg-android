<?xml version="1.0" encoding="utf-8"?>
<!-- Шапка главного экрана — ОБЩАЯ для обеих ориентаций (portrait и layout-land).
     Вынесена в отдельный файл, чтобы у двух раскладок не завелось двух копий разметки,
     которые потом разъедутся (04-08). Правится ЗДЕСЬ, оба экрана подхватывают. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Шапка (правка владельца 2026-07-18): слева — тема (солнце/луна/авто),
         ПО ЦЕНТРУ — селектор пресета split-туннеля (SPEC-0028), справа — настройки.
         Переключатель языка убран с главной — он теперь только в настройках. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_theme_button"
            style="@style/Mayak.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:contentDescription="@string/mayak_theme"
            app:icon="@drawable/ic_theme_dark"
            app:iconTint="@color/mayak_on_bg"
            app:iconSize="24dp"
            app:iconPadding="0dp"
            android:text="" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Селектор пресета split-туннеля (SPEC-0028): имя активного пресета (тап → выбор/
             создание/правка) + тумблер «применять пресет». Видимость — настройка
             «Показывать пресеты на главном» (по умолч. ВКЛ). Текст имени ставится в коде. -->
        <LinearLayout
            android:id="@+id/mayak_preset_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Имя пресета: без иконки (правка владельца 2026-07-18 — «без 3х точек»),
                 компактно, имя влезает целиком (без maxWidth/ellipsize), шрифт помельче. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_preset_name"
                style="@style/Mayak.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:text="РФ напрямую" />

            <!-- Тумблер «применять пресет»: уменьшен (scale 0.8) и подтянут вплотную —
                 компактнее, чтобы имя пресета помещалось целиком (правка владельца). -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mayak_preset_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-2dp"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:contentDescription="@string/mayak_preset_switch_desc" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Ящик сообщений (SPEC-0047). Стоит В ШАПКЕ, а не в настройках, ровно по одной причине:
             до него канала до человека без почты не было вовсе, и прятать его на пятом экране
             прокрутки — значит снова не доставить. Кружок с числом непрочитанного ставится кодом
             (updateMessagesBadge) и виден без всякой сети — по данным прошлой проверки. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_messages_button"
                style="@style/Mayak.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:contentDescription="@string/mayak_messages_title"
                app:icon="@drawable/ic_message"
                app:iconTint="@color/mayak_on_bg"
                app:iconSize="22dp"
                app:iconPadding="0dp"
                android:text="" />

            <TextView
                android:id="@+id/mayak_messages_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/mayak_bg_unread_badge"
                android:gravity="center"
                android:minWidth="16dp"
                android:minHeight="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_settings_button"
            style="@style/Mayak.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:contentDescription="@string/mayak_settings"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/mayak_on_bg"
            app:iconSize="22dp"
            app:iconPadding="0dp"
            android:text="" />
    </LinearLayout>

    <!-- Подпись под полоской пресета (находка 03-08-2026): человек впервые открывший приложение
         видит только имя пресета и тумблер — без объяснения, что это split-туннель и что
         по умолчанию он пускает российские сервисы напрямую. Видимость — вместе с mayak_preset_bar
         (updatePresetSelector), мелкий приглушённый шрифт, чтобы не спорить с заголовком. -->
    <TextView
        android:id="@+id/mayak_preset_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg_muted"
        android:textSize="11sp"
        android:visibility="gone"
        android:text="@string/mayak_home_preset_hint" />
</merge>
