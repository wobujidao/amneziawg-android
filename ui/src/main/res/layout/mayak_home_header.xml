<?xml version="1.0" encoding="utf-8"?>
<!-- Шапка главного экрана — ОБЩАЯ для обеих ориентаций (portrait и layout-land).
     Вынесена в отдельный файл, чтобы у двух раскладок не завелось двух копий разметки,
     которые потом разъедутся (04-08). Правится ЗДЕСЬ, оба экрана подхватывают. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Шапка (правка владельца 2026-07-18): слева — тема (солнце/луна/авто),
         ПО ЦЕНТРУ — селектор пресета split-туннеля (SPEC-0028), справа — настройки.
         Переключатель языка убран с главной — он теперь только в настройках.
         Шапка выдвинута на 12dp в обе стороны за колонку содержимого (это −@dimen/mayak_icon_inset;
         отрицательное значение ссылкой не запишешь): кнопки-значки — коробки 48dp со значком 24dp
         по центру, то есть сам значок утоплен на 12dp. Без компенсации «Тема» слева и «Настройки»
         справа стояли на 32dp от края экрана при карточке стран на 20dp — шапка выглядела уже
         экрана под ней (ревизия 21-08). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:layout_marginEnd="-12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_theme_button"
            style="@style/Mayak.Button.Text.Icon48"
            android:contentDescription="@string/mayak_theme"
            app:icon="@drawable/ic_theme_dark"
            app:iconTint="@color/mayak_on_bg"
            app:iconSize="@dimen/mayak_icon"
            android:text="" />

        <!-- Отсек пресета занимает ВЕСЬ остаток ширины между темой и кнопками справа, а полоска
             пресета центрируется внутри него — визуально то же, что дававшие середину два
             спейсера с weight=1, которые тут стояли раньше. Зачем перестроено (замер 15-08,
             системный шрифт 200 %): полоска была нерастяжимой, и когда имя пресета выросло,
             оно вытолкнуло за правый край кнопку настроек ЦЕЛИКОМ (осталось 8dp — не нажать).
             Теперь при нехватке места сжимается ИМЯ ПРЕСЕТА (с многоточием), а не соседи:
             отсек ограничивает ширину, weight=1 на имени внутри полоски отдаёт дефицит ему.
             При обычном шрифте полоска wrap_content — выглядит как раньше, ничего не тянется. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- Селектор пресета split-туннеля (SPEC-0028): имя активного пресета (тап → выбор/
                 создание/правка) + тумблер «применять пресет». Видимость — настройка
                 «Показывать пресеты на главном» (по умолч. ВКЛ). Текст имени ставится в коде. -->
            <LinearLayout
                android:id="@+id/mayak_preset_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Имя пресета: без иконки (правка владельца 2026-07-18 — «без 3х точек»),
                     компактно, шрифт помельче. При обычном шрифте имя влезает целиком (weight
                     не растягивает: полоска wrap_content); многоточие — только когда имя
                     физически не помещается (крупный системный шрифт).
                     Высота 48dp — минимум Google: 40dp были единственной целью нажатия на главном
                     ниже минимума, а строка шапки и так 48dp, поэтому экран не вырос (21-08). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mayak_preset_name"
                    style="@style/Mayak.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="@dimen/mayak_touch"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/mayak_space_3"
                    android:paddingEnd="@dimen/mayak_space_3"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:text="РФ напрямую" />

                <!-- Тумблер «применять пресет»: уменьшен (scale 0.8) и подтянут вплотную —
                     компактнее, чтобы имя пресета помещалось целиком (правка владельца).
                     −2dp — не «на глаз»: MaterialSwitch несёт собственное внутреннее поле, и после
                     сжатия до 0.8 слева от него оставался лишний воздух (scaleX ужимает рисунок, а
                     не занятое место). Отступ гасит ровно этот остаток. Обновится Material —
                     проверить глазами: значение уедет молча.
                     ⚠️ Область нажатия держит НЕ разметка, а TouchDelegate в MayakActivity:
                     `scale 0.8` ужимает рисунок вместе с областью нажатия, и цель была 42×38dp при
                     минимуме Google 48. minWidth/minHeight ниже оставлены как страховка на случай
                     смены Material, но сами по себе они ничего не меняют: натуральный размер
                     MaterialSwitch и так ≈52×48dp. Снимете делегат — цель снова станет 42×38 (ревью
                     22-08 поймал ровно это заблуждение в прежней редакции комментария). -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/mayak_preset_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-2dp"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    android:contentDescription="@string/mayak_preset_switch_desc"
                    android:minWidth="@dimen/mayak_touch"
                    android:minHeight="@dimen/mayak_touch" />
            </LinearLayout>
        </FrameLayout>

        <!-- Ящик сообщений (SPEC-0047). Стоит В ШАПКЕ, а не в настройках, ровно по одной причине:
             до него канала до человека без почты не было вовсе, и прятать его на пятом экране
             прокрутки — значит снова не доставить. Кружок с числом непрочитанного ставится кодом
             (updateMessagesBadge) и виден без всякой сети — по данным прошлой проверки. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_messages_button"
                style="@style/Mayak.Button.Text.Icon48"
                android:contentDescription="@string/mayak_messages_title"
                app:icon="@drawable/ic_bell"
                app:iconTint="@color/mayak_on_bg"
                app:iconSize="@dimen/mayak_icon"
                android:text="" />

            <TextView
                android:id="@+id/mayak_messages_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="@dimen/mayak_space_1"
                android:background="@drawable/mayak_bg_unread_badge"
                android:gravity="center"
                android:minWidth="16dp"
                android:minHeight="16dp"
                android:paddingStart="@dimen/mayak_space_1"
                android:paddingEnd="@dimen/mayak_space_1"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_settings_button"
            style="@style/Mayak.Button.Text.Icon48"
            android:contentDescription="@string/mayak_settings"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/mayak_on_bg"
            app:iconSize="@dimen/mayak_icon"
            android:text="" />
    </LinearLayout>

    <!-- Подпись под полоской пресета (находка 03-08-2026): человек впервые открывший приложение
         видит только имя пресета и тумблер — без объяснения, что это split-туннель и что
         по умолчанию он пускает российские сервисы напрямую. Видимость — вместе с mayak_preset_bar
         (updatePresetSelector), мелкий приглушённый шрифт, чтобы не спорить с заголовком. -->
    <TextView
        android:id="@+id/mayak_preset_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg_muted"
        android:textSize="11sp"
        android:visibility="gone"
        android:text="@string/mayak_home_preset_hint" />
</merge>
