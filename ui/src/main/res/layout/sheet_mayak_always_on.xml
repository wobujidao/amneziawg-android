<?xml version="1.0" encoding="utf-8"?>
<!-- Нижний лист «Чтобы связь не рвалась в кармане»: открывается ОДИН раз, после первого успешного
     подключения. Единственное место, где мы вообще заговариваем про постоянное подключение —
     подсказка в «Настройках → Защита» лежит на пятом экране, и новичок туда не доходит.
     Правило показа — core.AlwaysOnNudge (под юнит-тестом), сама логика — MayakActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mayak_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <!-- Хваталка листа -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/mayak_sheet_grabber" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_power"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/mayak_alwayson_title"
            android:textColor="@color/mayak_on_bg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/mayak_alwayson_body"
            android:textColor="@color/mayak_on_bg"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/mayak_alwayson_how"
            android:textColor="@color/mayak_on_bg_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_alwayson_open"
            style="@style/Mayak.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mayak_alwayson_open" />

        <!-- Два выхода из разговора. Разные по смыслу: «уже включено» — утверждение о состоянии
             телефона (проверить его мы не можем, см. MayakAlwaysOn), «позже» — отсрочка. Оба
             закрывают карточку навсегда: повторно долбить человека тем же окном мы не будем. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_alwayson_done"
                style="@style/Mayak.Button.Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/mayak_alwayson_done" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_alwayson_later"
                style="@style/Mayak.Button.Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/mayak_alwayson_later" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
