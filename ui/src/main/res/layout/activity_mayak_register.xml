<?xml version="1.0" encoding="utf-8"?>
<!-- Регистрация ПРЯМО В ПРИЛОЖЕНИИ (SPEC-0048). Три шага живут в одной разметке и переключаются
     видимостью — так состояние переживает поворот экрана без сохранения половины экрана в Bundle:

       1. mayak_reg_step_form    — пароль (с генератором), согласие, кнопка;
       2. mayak_reg_step_captcha — виджет «не робот» в WebView (ПОЛНЫЙ экран, вне ScrollView:
                                   WebView внутри прокрутки конфликтует с ней жестами);
       3. mayak_reg_step_done    — номер аккаунта, показанный ОДИН раз.

     Кнопка «Создать аккаунт» приезжает ВЫКЛЮЧЕННОЙ (android:enabled="false") — включает её только
     отметка согласия: `consent_required` серверное правило, и соблюдать его надо на экране, а не
     ловить отказом после запроса. Это проверяет сторож MayakRegisterGuardTest. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mayak_bg_gradient">

    <ScrollView
        android:id="@+id/mayak_reg_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mayak_reg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/mayak_space_5"
            android:paddingEnd="@dimen/mayak_space_5"
            android:paddingTop="@dimen/mayak_space_4"
            android:paddingBottom="@dimen/mayak_space_7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mayak_reg_back"
                    style="@style/Mayak.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/mayak_back"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconSize="24dp"
                    app:iconTint="@color/mayak_on_bg" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/mayak_space_2"
                    android:layout_weight="1"
                    android:text="@string/mayak_reg_title"
                    android:textAppearance="@style/Mayak.Title"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- ===== Шаг 1: форма ===== -->
            <LinearLayout
                android:id="@+id/mayak_reg_step_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Mayak.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mayak_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mayak_reg_intro"
                            android:textAppearance="@style/Mayak.Tagline"
                            android:textColor="@color/mayak_on_surface_muted" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/mayak_reg_password_layout"
                            style="@style/Mayak.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_4"
                            android:hint="@string/mayak_reg_password_hint"
                            app:endIconMode="password_toggle"
                            app:helperText="@string/mayak_reg_password_helper"
                            app:helperTextEnabled="true">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mayak_reg_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_3"
                            android:orientation="horizontal">

                            <!-- hyphenationFrequency: кнопки делят ширину пополам, и при крупном
                                 системном шрифте (200 %) слова рвались по буквам («Придум/ать»,
                                 «Скопир/овать» — замер 15-08); с дефисацией перенос читаемый.
                                 При обычном шрифте текст в одну строку — атрибут не влияет. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/mayak_reg_generate"
                                style="@style/Mayak.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hyphenationFrequency="normal"
                                android:text="@string/mayak_reg_generate" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/mayak_reg_copy_password"
                                style="@style/Mayak.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/mayak_space_2"
                                android:layout_weight="1"
                                android:hyphenationFrequency="normal"
                                android:text="@string/mayak_reg_copy_password" />
                        </LinearLayout>

                        <!-- Согласие. Ссылку на Политику держим ОТДЕЛЬНОЙ кнопкой, а не ссылкой внутри
                             подписи чекбокса: тап по подписи переключает сам чекбокс, и человек, целясь
                             в ссылку, вместо неё снимал бы согласие. -->
                        <!-- buttonTint фирменным тоном: дефолт Material красит «отмечено» лавандовым,
                             и на экране появлялось второе «включено» другого цвета (ту же правку
                             однажды делали тумблерам, см. res/color/mayak_switch_track.xml). -->
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/mayak_reg_consent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_4"
                            android:minHeight="48dp"
                            android:text="@string/mayak_reg_consent"
                            android:textColor="@color/mayak_on_surface"
                            app:buttonTint="@color/mayak_outline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mayak_reg_policy"
                            style="@style/Mayak.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mayak_outline"
                            android:text="@string/mayak_privacy_policy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mayak_reg_submit"
                            style="@style/Mayak.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_3"
                            android:enabled="false"
                            android:text="@string/mayak_reg_title" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== Шаг 3: номер аккаунта ===== -->
            <LinearLayout
                android:id="@+id/mayak_reg_step_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Mayak.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mayak_space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mayak_reg_done_title"
                            android:textAppearance="@style/Mayak.CardTitle" />

                        <!-- Номер крупно и монопространственно: его переписывают на бумагу и диктуют. -->
                        <TextView
                            android:id="@+id/mayak_reg_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_3"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:letterSpacing="0.05"
                            android:textColor="@color/mayak_on_surface"
                            android:textIsSelectable="true"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="019-785-686" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mayak_reg_copy_number"
                            style="@style/Mayak.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_3"
                            android:text="@string/mayak_account_number_copy" />

                        <!-- Пробный срок — только если сервер его назвал (trial_days > 0). Своих
                             «7 дней» приложение не придумывает: это настройка сервера. -->
                        <TextView
                            android:id="@+id/mayak_reg_trial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_3"
                            android:textAppearance="@style/Mayak.Tagline"
                            android:textColor="@color/mayak_on_surface"
                            android:visibility="gone"
                            tools:text="Пробный доступ уже включён: 7 дн."
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/mayak_reg_done_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_3"
                            android:text="@string/mayak_reg_done_warning"
                            android:textAppearance="@style/Mayak.Tagline"
                            android:textColor="@color/mayak_on_surface_muted" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mayak_reg_continue"
                            style="@style/Mayak.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/mayak_space_5"
                            android:text="@string/mayak_reg_continue" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Отказ словами. Живёт под карточкой и на шаге формы, и на шаге номера: причина
                 всегда одна и та же строка, чтобы её нельзя было забыть обновить в двух местах. -->
            <TextView
                android:id="@+id/mayak_reg_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_4"
                android:textColor="@color/mayak_red"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Проверка «не робот» не пройдена."
                tools:visibility="visible" />

            <!-- ВТОРАЯ ДОРОГА. Показывается только после провала: до него она сбивала бы с толку
                 («зачем браузер, если есть форма?»), а после — единственный способ не оставить
                 человека в тупике. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_reg_browser"
                style="@style/Mayak.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_3"
                android:text="@string/mayak_reg_browser"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Шаг 2: проверка «не робот» ===== -->
    <LinearLayout
        android:id="@+id/mayak_reg_step_captcha"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mayak_bg_gradient"
        android:orientation="vertical"
        android:paddingStart="@dimen/mayak_space_4"
        android:paddingEnd="@dimen/mayak_space_4"
        android:paddingTop="@dimen/mayak_space_4"
        android:paddingBottom="@dimen/mayak_space_5"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_reg_captcha_back"
                style="@style/Mayak.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/mayak_back"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text=""
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="24dp"
                app:iconTint="@color/mayak_on_bg" />

            <TextView
                android:id="@+id/mayak_reg_captcha_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/mayak_space_2"
                android:layout_weight="1"
                android:text="@string/mayak_reg_captcha_wait"
                android:textColor="@color/mayak_on_bg_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Единственный WebView приложения. JS в нём включается кодом (MayakRegisterActivity) —
             вместе со всеми запретами, которые к этому обязывают. -->
        <WebView
            android:id="@+id/mayak_reg_web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/mayak_space_3"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
