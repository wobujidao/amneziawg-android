<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка «Выберите страну» — ОБЩАЯ для обеих ориентаций (portrait и layout-land). Родитель
     («отсек») задаёт ей место: в портрете это полоса от кнопки до низа экрана, в альбоме — ЛЕВАЯ
     колонка во всю высоту. Сама карточка всегда wrap_content и прижата к верху отсека: при двух
     странах в ней нет пустоты, при длинном списке прокручивается внутренний ScrollView.
     Поля сверху и снизу — 12dp вместо общих для карточек 20dp (20-08): содержимое тут не текст, а
     строки высотой 48dp, у которых свой воздух внутри, и на невысоких экранах эти 16dp решали,
     влезут три страны или список начнёт прокручиваться. По бокам поля прежние (20dp) — иначе
     левый край карточки разъедется с остальными экранами. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Mayak.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    app:contentPaddingTop="@dimen/mayak_space_3"
    app:contentPaddingBottom="@dimen/mayak_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Крупный системный шрифт: заголовку остаётся треть карточки (справа «Авто» и
                 «Обновить»), и на 200 % слово «Выберите» рвалось ПО БУКВАМ на три строки
                 (замер 15-08). Лекарство двойное: автоподбор размера (16→12sp) ужимает текст,
                 дефисация даёт читаемый перенос там, где слово всё равно шире колонки (на
                 200 % «Выберите» не влезает целиком даже на 12sp — без дефисов резалось бы).
                 maxLines=3 — предел, до которого автоподбор ужимает размер; текст не теряется.
                 При обычном шрифте — одна строка на max-размере, вид прежний. -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="3"
                android:hyphenationFrequency="normal"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                android:text="@string/mayak_pick_country"
                android:textAppearance="@style/Mayak.CardTitle" />

            <!-- SPEC-0031: режим сортировки (Авто/Свои) — переключатель. Режим «Пинг» снят 15-08
                 вместе с клиентским пингом напротив стран (директива владельца). -->
            <TextView
                android:id="@+id/mayak_sort_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/mayak_sort_auto"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/mayak_refresh_dirs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/mayak_refresh"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Плитка «⚡ Рекомендуем» (SPEC-0031 T3, хвост F-T5) — рекомендованное ЯДРОМ направление
             отдельным заметным элементом НАД списком, а не ещё одним бейджем в строке. Кого
             рекомендовать, решает сервер (recommended:true в /v1/client/directions — живое
             направление с наименьшей загрузкой); клиент рекомендацию не выдумывает: нет пометки —
             плитки нет (visibility ставит MayakActivity.renderRecommendedTile). Внутрь слота код
             кладёт ОБЫЧНУЮ строку-страну (mayak_country_row): флаг, название, пинг и выбор по тапу
             достаются даром и не расходятся со списком. -->
        <LinearLayout
            android:id="@+id/mayak_recommended_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:background="@drawable/mayak_bg_recommended_tile"
            android:foreground="@drawable/mayak_fg_recommended_tile"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/mayak_space_3"
                android:paddingEnd="@dimen/mayak_space_3"
                android:text="@string/mayak_recommended_tile"
                android:textColor="@color/mayak_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <FrameLayout
                android:id="@+id/mayak_recommended_row_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Прокрутка списка внутри карточки. Высоты хватает ровно на то, что даёт
             отсек-родитель (см. коммент у карточки выше): при 2-3 странах список
             помещается целиком без прокрутки, при длинном — прокручивается, а не
             уходит за нижний край. Разделители между строками — через
             showDividers="middle" на самом контейнере строк (divider = 1dp линия). -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/mayak_dirs_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@drawable/mayak_row_divider"
                android:showDividers="middle" />
        </ScrollView>

        <!-- Состояние «строк нет»: пустой список ИЛИ отказ загрузки. Раньше на этом месте не было
             ничего — только фраза «Ядро не вернуло ни одной страны» мелким статусом под кнопкой,
             одна на обе беды сразу. Тексты и заголовок ставит код (см. MayakActivity.showDirsState):
             «сервер ответил, но стран нет» и «список не загрузился» — разные причины и разные
             действия, одной формулировкой их накрывать нельзя. -->
        <LinearLayout
            android:id="@+id/mayak_dirs_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mayak_dirs_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/mayak_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mayak_dirs_state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/mayak_on_bg_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_dirs_state_action"
                style="@style/Mayak.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
