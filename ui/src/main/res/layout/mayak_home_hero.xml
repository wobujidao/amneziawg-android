<?xml version="1.0" encoding="utf-8"?>
<!-- Круг подключения со статусом, таймером, IP, пингом/значками и сроком доступа — ОБЩИЙ блок
     для обеих ориентаций (portrait и layout-land). В портрете вставляется в общий вертикальный
     столбец, в альбоме — в ПРАВУЮ колонку. Родитель обязан быть вертикальным LinearLayout с
     gravity="center_horizontal" и clipChildren="false" (волны рисуются за границами круга). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Центр: волны (ripple) + внешний ореол (glow) + круглая кнопка подключения.
         Отсек ростом РОВНО с круг (mayak_connect_circle), а волны и ореол крупнее его
         (mayak_connect_area) и рисуются ЗА его границами — поэтому у них clipChildren="false"
         на всех родителях выше. Раньше отсек был размером с волны, и по 40dp сверху и снизу
         кнопки всегда пустовало: при подключении строки статуса (Защищено/пинг/IPv6) толкали
         список вниз, хотя место рядом с кнопкой простаивало (голосовая правка владельца 04-08:
         «подними кнопку выше, размер оставь, отступы сверху и снизу сожми вдвое»).
         Размер кнопки при этом прежний — 176dp, ход волн прежний (256/2 − 176/2 = 40dp). -->
    <FrameLayout
        android:layout_width="@dimen/mayak_connect_circle"
        android:layout_height="@dimen/mayak_connect_circle"
        android:layout_marginTop="@dimen/mayak_space_3"
        android:clipChildren="false">

        <!-- Концентрические волны от кнопки (sonar/активация при подключении) -->
        <org.amnezia.awg.mayak.RippleView
            android:id="@+id/mayak_ripple"
            android:layout_width="@dimen/mayak_connect_area"
            android:layout_height="@dimen/mayak_connect_area"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <!-- Ореол за кругом: больше круга, выходит за его границы. Альфа меняется кодом. -->
        <View
            android:id="@+id/mayak_connect_glow"
            android:layout_width="@dimen/mayak_connect_area"
            android:layout_height="@dimen/mayak_connect_area"
            android:layout_gravity="center"
            android:background="@drawable/mayak_circle_glow"
            android:alpha="0"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/mayak_connect_circle"
            android:layout_width="@dimen/mayak_connect_circle"
            android:layout_height="@dimen/mayak_connect_circle"
            android:layout_gravity="center"
            android:background="@drawable/mayak_circle_disconnected"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/mayak_a11y_connect">

            <ImageView
                android:id="@+id/mayak_connect_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_power"
                app:tint="@color/mayak_circle_icon_off" />
        </FrameLayout>
    </FrameLayout>

    <!-- Статус + блок инфо (время/IP/пинг). Отступ считается от КРАЯ КРУГА (отсек кнопки
         теперь ростом с сам круг, волны рисуются поверх) — поэтому space_2→space_5: на глаз
         зазор стал вдвое меньше прежнего (было 40dp пустого поля волн + 8dp), а не вплотную.
         20-08: space_5 → space_3 здесь и над кругом. Это 16dp, которых на невысоком экране не
         хватало списку стран при поднятом туннеле; зазор остаётся видимым (12dp), просто перестал
         быть самым большим пустым местом экрана. -->
    <!-- 🔴 Строка статуса — ЕДИНСТВЕННЫЙ вход в лист «Подробности подключения» (а после неудачи —
         в помощь), и при этом сама надпись высотой ~21dp: палец промахивался в межстрочный зазор
         (ревизия 21-08, A4). Цель нажатия — 48dp, минимум Google.
         Верхний отступ при этом СНЯТ намеренно: коробка 48dp несёт свой воздух сама (текст в ней по
         центру, сверху и снизу ~13dp), поэтому зазор до круга на глаз остался прежним — иначе он бы
         удвоился. Соседние таймер и пинг открывают тот же лист и лежат вплотную под этой коробкой,
         так что вместе они дают сплошную область нажатия; растить ещё и их нельзя — главный экран и
         так впритык помещается на 360×720dp (жалоба владельца 20-08 про прокрутку всей страницы). -->
    <TextView
        android:id="@+id/mayak_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/mayak_touch"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/mayak_status_disconnected" />

    <!-- Таймер сессии (виден только при подключении). Своего верхнего отступа нет: его даёт нижний
         воздух коробки статуса (48dp вокруг текста ~21dp) — иначе зазор сложился бы вдвое. -->
    <TextView
        android:id="@+id/mayak_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg_muted"
        android:textSize="15sp"
        android:visibility="gone"
        tools:ignore="HardcodedText"
        android:text="00:00:00" />

    <!-- Внешний IP (виден при подключении) -->
    <TextView
        android:id="@+id/mayak_ip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_1"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg_muted"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="" />

    <!-- Компактная строка: пинг + значок IPv6 в ОДНУ линию (правка владельца: меньше строк на главном).
         Каждый элемент показывается/прячется кодом независимо; при отключении строка схлопывается. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mayak_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/mayak_on_bg_muted"
            android:textSize="14sp"
            android:visibility="gone"
            android:text="" />

        <!-- Значок «IPv6» (только когда IPv6 реально работает через туннель — честно) -->
        <TextView
            android:id="@+id/mayak_ipv6_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mayak_space_2"
            android:background="@drawable/mayak_bg_ipv6_badge"
            android:paddingHorizontal="@dimen/mayak_space_2"
            android:paddingVertical="2dp"
            android:gravity="center"
            android:textColor="@color/mayak_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="HardcodedText"
            android:text="IPv6" />

        <!-- Значок «Резерв»: подключены через запасной канал (AWG внутри HTTPS), а не по UDP.
             Канал медленнее прямого — пользователь должен видеть, почему цифры другие (SPEC-0039). -->
        <TextView
            android:id="@+id/mayak_fallback_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mayak_space_2"
            android:background="@drawable/mayak_bg_ipv6_badge"
            android:paddingHorizontal="@dimen/mayak_space_2"
            android:paddingVertical="2dp"
            android:gravity="center"
            android:textColor="@color/mayak_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="@string/mayak_fallback_badge" />
    </LinearLayout>

    <!-- Скорость (↓/↑; включается в настройках) — одна мелкая строка -->
    <TextView
        android:id="@+id/mayak_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_1"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg_muted"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="" />

    <!-- Срок доступа. До 2026-08-01 человек узнавал про свои пробные 7 дней ТОЛЬКО в самом
         низу настроек, на пятом экране прокрутки (аудит 31-07, п. 11) — то есть не узнавал.
         Строка появляется, когда ядро ответило про аккаунт; тап ведёт в кабинет (продлить).
         Текст общий с настройками — MayakAccessLine. -->
    <TextView
        android:id="@+id/mayak_access"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_1"
        android:gravity="center"
        android:textColor="@color/mayak_on_bg_muted"
        android:textSize="13sp"
        android:padding="@dimen/mayak_space_1"
        android:minHeight="@dimen/mayak_touch"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:text="" />
</merge>
