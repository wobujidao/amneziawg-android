<?xml version="1.0" encoding="utf-8"?>
<!-- Строка-страна (Happ-стиль): ВЕКТОРНЫЙ флаг + название + шеврон. Выбранная подсвечивается
     фоном mayak_row_selected (левый акцентный бар). Тап = ВЫБОР (не подключение). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mayak_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:paddingStart="@dimen/mayak_space_3"
    android:paddingEnd="@dimen/mayak_space_3"
    android:paddingTop="@dimen/mayak_space_1"
    android:paddingBottom="@dimen/mayak_space_1"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <!-- Флаг. По умолчанию — ЭМОДЗИ (те же, что в шторке уведомления): владелец 04-08 сказал, что
         они симпатичнее наших плоских прямоугольников — у системных глифов скруглённые углы и лёгкая
         тень. Но эмодзи-флаги есть не в каждой прошивке (часть китайских сборок их вырезает), а
         страна без флага в списке — это пустой квадрат вместо картинки. Поэтому в строке лежат ОБА
         варианта, и код показывает эмодзи, только если система умеет его нарисовать
         (Paint.hasGlyph); иначе остаётся наш векторный флаг из ресурсов. -->
    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="20dp">

        <ImageView
            android:id="@+id/mayak_row_flag"
            android:layout_width="26dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/flag_globe" />

        <TextView
            android:id="@+id/mayak_row_flag_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="17sp"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Название + город В ОДНУ строку (правка владельца 04-08). Было двумя строками (SPEC-0037,
         approved-idle.png) — строка выходила ~54dp, и десяток направлений на экран не помещался.
         Город приписывается сбоку («Нидерланды · Амстердам»), строка стала ~40dp: влезает ~11.
         Название — по содержимому, город — на остатке ширины (сожмётся и обрежется первым). -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/mayak_space_3"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <!-- hyphenationFrequency — на случай переноса: при крупном системном шрифте код
             (countryRow) разрешает имени 2 строки, и без дефисации «Нидерланды» рвалось бы по
             буквам; при одной строке (обычный шрифт) атрибут ни на что не влияет. -->
        <TextView
            android:id="@+id/mayak_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mayak_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:hyphenationFrequency="normal"
            android:text="—" />

        <TextView
            android:id="@+id/mayak_row_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="@color/mayak_on_surface"
            android:alpha="0.6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Точка «идёт трафик через эту страну» (пункт бэклога «выбрана И подключена»). Показывается
         ТОЛЬКО у активного направления при поднятом туннеле. Зачем: подсветка строки означает
         «выбрана», и она одинакова при включённом и выключенном VPN — по списку нельзя было понять,
         где сейчас идёт трафик. Своей подписи нет: у неё contentDescription для скринридера. -->
    <View
        android:id="@+id/mayak_row_connected_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/mayak_dot_connected"
        android:visibility="gone" />

    <!-- Бейдж «IPv6» (директива владельца 01-07). Зажигается КОДОМ и ТОЛЬКО по явному ipv6:true из
         /v1/client/directions — проверенному egress-признаку выходной ноды, тем же, по которому чип
         живёт на лендинге и в кабинете. Не по AAAA и не по догадкам — иначе бейдж врёт. Пилюля — та
         же, что у значков «IPv6»/«Резерв» на главном (mayak_bg_ipv6_badge), только мельче: строка
         списка ~40dp. Текст «IPv6» — имя протокола, не переводится (как у значка в hero). -->
    <TextView
        android:id="@+id/mayak_row_ipv6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/mayak_bg_ipv6_badge"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:gravity="center"
        android:textColor="@color/mayak_accent"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:ignore="HardcodedText,SmallSp"
        android:text="IPv6" />

    <!-- Ячейки клиентского пинга («129 мс») здесь больше НЕТ — снята 15-08 по директиве владельца
         («это не работает и задумывалось совсем по-другому»). Пинг живого туннеля остался на главном
         экране под статусом («Пинг: N мс»). Правый край строки теперь держит пилюля «IPv6»
         (или точка «подключено»), отступ края — paddingEnd корня. -->
</LinearLayout>
