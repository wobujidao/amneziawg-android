<?xml version="1.0" encoding="utf-8"?>
<!-- Экран входа «Mayak Networks»: брендовый градиентный фон, логотип-маяк, карточка с формой. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mayak_bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <!-- paddingTop — зазор ПОД статус-баром; его высоту добавляет код (MayakSystemBars.padForBars
             в showLogin), иначе на телефонах с высоким баром переключатель темы уезжает под часы. -->
        <LinearLayout
            android:id="@+id/mayak_login_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/mayak_space_5"
            android:paddingEnd="@dimen/mayak_space_5"
            android:paddingTop="@dimen/mayak_space_2"
            android:paddingBottom="@dimen/mayak_space_7">

            <!-- Шапка: слева — переключатель темы (солнце/луна/авто), справа — язык.
                 Тап-таргеты 48dp (доступность, см. дизайн-ревью §3.6). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mayak_theme_button"
                    style="@style/Mayak.Button.Text"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:contentDescription="@string/mayak_theme"
                    app:icon="@drawable/ic_theme_dark"
                    app:iconGravity="textStart"
                    app:iconTint="@color/mayak_on_bg"
                    app:iconSize="24dp"
                    app:iconPadding="0dp"
                    android:text="" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mayak_language_button"
                    style="@style/Mayak.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/mayak_space_3"
                    android:paddingEnd="@dimen/mayak_space_3"
                    app:icon="@drawable/ic_language"
                    app:iconTint="@color/mayak_on_bg"
                    app:iconSize="18dp"
                    android:text="@string/mayak_language" />
            </LinearLayout>

            <ImageView
                android:id="@+id/mayak_logo"
                android:layout_width="@dimen/mayak_login_logo"
                android:layout_height="@dimen/mayak_login_logo"
                android:layout_marginTop="@dimen/mayak_space_3"
                android:importantForAccessibility="no"
                android:src="@drawable/mayak_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_4"
                android:text="@string/app_name"
                android:textAppearance="@style/Mayak.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_2"
                android:text="@string/mayak_tagline"
                android:textAppearance="@style/Mayak.Tagline" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- hintMaxLines=2 (Material 1.14): при крупном системном шрифте (200 %)
                         однострочная подсказка резалась в «Почта или номер а…» — человек не
                         узнавал, что сюда можно ввести НОМЕР, а именно он якорь входа без почты
                         (замер 15-08). При обычном шрифте подсказка — одна строка, как была. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/mayak_login_layout"
                        style="@style/Mayak.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintMaxLines="2"
                        android:hint="@string/mayak_login_hint">

                        <!-- Логин — ПОЧТА ИЛИ НОМЕР АККАУНТА (9 цифр). Поле было объявлено почтовым
                             (inputType=textEmailAddress + подпись «Email»), и человек без почты не
                             догадывался, что сюда можно ввести номер: вход по нему на сервере
                             работает с 11-08, мешали только слова и клавиатура. Держим обычный
                             текст: почтовая клавиатура прячет цифры, цифровая — собаку.
                             autofillHints=username, чтобы менеджер паролей подставлял логин, а не
                             перебирал адреса почты. -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mayak_login"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:autofillHints="username"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/mayak_password_layout"
                        style="@style/Mayak.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_4"
                        app:endIconMode="password_toggle"
                        android:hint="@string/mayak_password_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mayak_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Код двухфакторной аутентификации. Скрыт, пока ядро не ответит totp_required:
                         у подавляющего большинства 2FA выключена, и лишнее поле на первом экране их
                         бы только пугало. Показываем ровно тогда, когда пароль уже принят и не хватает
                         только кода (та же одно-запросная модель, что в кабинете). -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/mayak_totp_layout"
                        style="@style/Mayak.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_4"
                        android:visibility="gone"
                        app:helperTextEnabled="true"
                        app:helperText="@string/mayak_totp_helper"
                        android:hint="@string/mayak_totp_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/mayak_totp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:autofillHints="password"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_sign_in"
                        style="@style/Mayak.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_5"
                        android:text="@string/mayak_sign_in" />

                    <!-- Забыли пароль? — сброс по email-коду (POST /v1/auth/password/forgot+/reset). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_forgot_password"
                        style="@style/Mayak.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_1"
                        android:textColor="@color/mayak_outline"
                        android:text="@string/mayak_forgot_password" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/mayak_space_5"
                        android:layout_marginBottom="@dimen/mayak_space_4"
                        android:background="@color/mayak_divider" />

                    <!-- Здесь были «Сканировать QR-код» и «Вставить регистрационную ссылку».
                         Убраны (аудит 2026-07-31, п. 10): схему mayak://reg НИКТО не выдаёт — ни сайт,
                         ни кабинет, ни бот (проверено grep'ом по всему продукту, ноль попаданий). Взять
                         такую ссылку человеку было негде, то есть оба пункта вели в тупик. Понадобятся
                         снова — вернуть их надо не кнопкой, а deep-link'ом mayak:// в манифесте;
                         разбор ссылки со всей защитой (opaque-URI, sanitizeServer) лежит в истории git
                         и в core/RegLink. -->
                    <!-- Регистрация теперь СВОИМ экраном (SPEC-0048), а не уходом в браузер: до
                         13-08 эта кнопка открывала веб-кабинет, человек заводил там аккаунт и
                         возвращался вводить номер и пароль заново — на этом шаге терялась половина
                         людей. Кнопка стала заметнее (обведённая, а не текстовая): это главная
                         дорога новичка, а не сноска под формой. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_register"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_2"
                        android:text="@string/mayak_reg_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/mayak_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_4"
                android:gravity="center"
                android:textColor="@color/mayak_on_bg_muted"
                android:textSize="14sp" />

            <!-- Согласие: названия Политики и Условий — ЖИВЫЕ ссылки, текст собирает
                 MayakLegalText.bindConsentNote (до 16-08 здесь был неоткрываемый текст). -->
            <TextView
                android:id="@+id/mayak_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_space_4"
                android:gravity="center"
                android:textColor="@color/mayak_on_bg_muted"
                android:textSize="12sp"
                tools:text="@string/mayak_consent_note_fmt" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
