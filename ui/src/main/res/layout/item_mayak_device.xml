<?xml version="1.0" encoding="utf-8"?>
<!-- Строка списка «Мои устройства»: имя, когда последний раз выходило на связь, и ЯВНАЯ кнопка
     «Отключить». Кнопка, а не «тапни по строке»: список открывают и просто посмотреть, а действие
     тут необратимое — оно должно называться словом, а не угадываться. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/mayak_on_surface"
            android:textAppearance="@style/Mayak.CardTitle"
            tools:text="Pixel 5 · это устройство" />

        <!-- Строк у подписи 4, а у имени 3 (было по 2): при системном шрифте 200 % подпись
             обрезалась на «это устройство…», и человек переставал видеть, КОГДА устройство
             добавлено и когда выходило на связь — то есть ровно то, по чему выбирают, какое
             отключать (замер на эмуляторе 18-08). При обычном шрифте обе строки короткие, вид
             прежний; список диалога прокручивается, поэтому лишняя высота не мешает. -->
        <TextView
            android:id="@+id/device_seen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/mayak_on_surface_muted"
            android:textAppearance="@style/Mayak.Tagline"
            tools:text="подключалось 4 часа назад" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/device_revoke"
        style="@style/Mayak.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mayak_devices_revoke" />

</LinearLayout>
