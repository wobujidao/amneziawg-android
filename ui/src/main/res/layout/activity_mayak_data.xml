<?xml version="1.0" encoding="utf-8"?>
<!-- «Какие данные мы собираем»: короткое раскрытие ВНУТРИ приложения, до начала пользования.
     Политика конфиденциальности у нас есть и она подробная, но она живёт в браузере и написана
     языком документа. 152-ФЗ требует, чтобы человек понимал, на что соглашается, а Google в анкете
     Data Safety спрашивает ровно эти категории — поэтому здесь то же самое, но списком и словами,
     которые читаются с телефона за минуту. Полный текст — кнопкой внизу.
     ⚠️ Разошлось с web/privacy.html — расходятся ОБА: правится и то, и другое. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mayak_bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/mayak_data_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/mayak_screen_h"
            android:paddingEnd="@dimen/mayak_screen_h"
            android:paddingTop="@dimen/mayak_screen_top"
            android:paddingBottom="@dimen/mayak_screen_bottom">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap"
                android:text="@string/mayak_data_intro"
                android:textAppearance="@style/Mayak.Tagline"
                android:textColor="@color/mayak_on_bg" />

            <!-- ЗАЧЕМ СИСТЕМНОЕ РАЗРЕШЕНИЕ — ПЕРВЫМ: Google требует, чтобы раскрытие объясняло,
                 зачем приложению VpnService и как он используется (отказ 19-08). -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mayak_data_vpn_head"
                        android:textAppearance="@style/Mayak.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_card_title_gap"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/mayak_data_vpn_body"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ЧТО СОБИРАЕМ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mayak_data_collect_head"
                        android:textAppearance="@style/Mayak.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_card_title_gap"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/mayak_data_collect_body"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ЧЕГО НЕ СОБИРАЕМ — главное, ради чего экран и заводился -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mayak_data_never_head"
                        android:textAppearance="@style/Mayak.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_card_title_gap"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/mayak_data_never_body"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- КУДА ЭТО ДЕВАЕТСЯ И КАК УБРАТЬ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mayak_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mayak_data_rights_head"
                        android:textAppearance="@style/Mayak.CardTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_card_title_gap"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/mayak_data_rights_body"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_data_privacy"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/mayak_space_4"
                        android:hyphenationFrequency="normal"
                        app:icon="@drawable/ic_action_open"
                        app:iconGravity="textStart"
                        android:text="@string/mayak_privacy_policy" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/mayak_data_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:background="@color/mayak_bg_grad_top"
        android:elevation="4dp"
        android:paddingStart="@dimen/mayak_space_2"
        android:paddingEnd="@dimen/mayak_screen_h"
        android:paddingTop="@dimen/mayak_space_1"
        android:paddingBottom="@dimen/mayak_space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_data_back"
            style="@style/Mayak.Button.Text.Icon48"
            android:contentDescription="@string/mayak_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/mayak_on_bg"
            app:iconSize="@dimen/mayak_icon"
            android:text="" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mayak_space_2"
            android:layout_weight="1"
            android:text="@string/mayak_data_title"
            android:textAppearance="@style/Mayak.Title"
            android:textSize="24sp" />
    </LinearLayout>
</FrameLayout>
