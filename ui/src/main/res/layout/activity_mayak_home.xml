<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран «Mayak Networks», ПОРТРЕТ: шапка (тема/пресет/настройки), большая круглая
     кнопка-подключение со статусом, ниже — карточка со списком стран.
     Альбомная версия — res/layout-land/activity_mayak_home.xml (две колонки). Общие куски лежат
     в mayak_home_header.xml / mayak_home_hero.xml / mayak_home_countries.xml и правятся ТАМ:
     двух копий одной разметки быть не должно, они разъезжаются. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@drawable/mayak_bg_gradient">

    <!-- Самый нижний слой: абстрактная сеть/карта (узлы + дуги + бегущие частицы), тихая,
         рисуется на Canvas без сети/SDK. Круг и список — поверх неё. -->
    <org.amnezia.awg.mayak.NetworkBackgroundView
        android:id="@+id/mayak_network_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Верх экрана неподвижен (шапка / кнопка / статус), прокручивается ТОЛЬКО список стран внутри
         карточки — правка владельца 2026-07-18. Внешний ScrollView с fillViewport этого не меняет:
         содержимому отдаётся ровно высота экрана, отсек с weight=1 забирает остаток, прокрутки не
         возникает. Он тут страховкой на случай, когда содержимое всё же выше экрана (крупный
         системный шрифт, маленький экран) — иначе низ просто обрезался бы. -->
    <ScrollView
        android:id="@+id/mayak_home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipChildren="false">

        <!-- paddingTop тут — ТОЛЬКО зазор под статус-баром, а не «отступ от края экрана»: высоту
             самого бара добавляет код (MayakSystemBars.padForBars в showHome). Раньше здесь стояло
             28dp «на глаз» — этого хватало телефонам со старым тонким баром, а на нынешних (вырез
             камеры, бар 44–49dp) шапка заезжала под часы; с targetSdk 35 Android 15 рисует окно
             от края до края всегда, так что зазор обязан считаться, а не угадываться. -->
        <LinearLayout
            android:id="@+id/mayak_home_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <include layout="@layout/mayak_home_header" />

            <include layout="@layout/mayak_home_hero" />

            <!-- Отсек под карточку забирает ВСЁ место, оставшееся до низа экрана (0dp + weight=1),
                 а сама карточка внутри него — wrap_content и прижата к верху. Отсюда оба нужных
                 поведения без единой строки кода:
                   • 2-3 строки  → карточка ровно по содержимому, внутри неё пустоты нет
                     (при layout_weight на самой карточке было ~500px пустоты — заход 02-08);
                   • 10 строк    → список дорастает точно до нижнего края и дальше прокручивается
                     внутри себя, а не уезжает за экран (правка владельца 04-08). -->
            <FrameLayout
                android:id="@+id/mayak_dirs_slot"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/mayak_space_4">

                <include layout="@layout/mayak_home_countries" />
            </FrameLayout>

            <!-- Версия бледным штампом у нижнего края (просьба владельца 2026-08-03). Зачем: люди
                 присылают скриншоты, и до сих пор приходилось отдельно спрашивать «а какая у вас
                 версия» — теперь она на самом кадре. Намеренно тихая (alpha), не кликается и
                 скринридеру не читается: это метка для нас, а не элемент интерфейса.
                 Лежит ПОСЛЕДНЕЙ строкой содержимого, а не слоем поверх экрана: слоем она в альбомной
                 ориентации наезжала на таймер сессии (замер 04-08). -->
            <TextView
                android:id="@+id/mayak_version_stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:alpha="0.38"
                android:textSize="11sp"
                android:textColor="@color/mayak_on_bg"
                android:importantForAccessibility="no"
                tools:text="v0.3.90 (137)" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
