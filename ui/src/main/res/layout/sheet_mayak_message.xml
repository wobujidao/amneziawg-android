<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка одного сообщения. Полный текст живёт ТОЛЬКО здесь: в шторке заголовок нейтральный, а
     на заблокированном экране текста не видно вовсе (VISIBILITY_PRIVATE) — уведомление читают через
     плечо. Открытие этой карточки и есть «прочитал»: отсюда уходит отметка на сервер. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mayak_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/mayak_space_6"
    android:paddingEnd="@dimen/mayak_space_6"
    android:paddingTop="@dimen/mayak_screen_top"
    android:paddingBottom="@dimen/mayak_space_6">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/mayak_space_4"
        android:background="@drawable/mayak_sheet_grabber" />

    <TextView
        android:id="@+id/mayak_message_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mayak_on_bg"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Доступ скоро закончится" />

    <TextView
        android:id="@+id/mayak_message_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_1"
        android:textAppearance="@style/Mayak.Tagline"
        android:textColor="@color/mayak_on_bg_muted"
        tools:text="5 минут назад" />

    <TextView
        android:id="@+id/mayak_message_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_4"
        android:textAppearance="@style/Mayak.Tagline"
        android:textColor="@color/mayak_on_bg"
        android:textIsSelectable="true"
        tools:text="Осталось дней: 3. Продлите, чтобы всё продолжало работать." />

    <!-- Кнопка действия. Её НЕТ, когда действие `none`: кнопка, которая никуда не ведёт, хуже её
         отсутствия. Название кнопки зависит от кода действия (оплата / обращение / устройства…). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mayak_message_action"
        style="@style/Mayak.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_5"
        android:visibility="gone"
        tools:text="Продлить доступ"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mayak_message_close"
        style="@style/Mayak.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mayak_space_1"
        android:text="@string/mayak_close" />
</LinearLayout>
