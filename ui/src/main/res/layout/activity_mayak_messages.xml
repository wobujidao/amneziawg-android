<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Сообщения» (SPEC-0047): всё, что мы человеку писали — чеки, срок доступа, ответы
     поддержки, приглашения. До него канала до людей без почты не было вовсе.

     Три РАЗНЫХ состояния под списком, и путать их нельзя:
       • «загружаем…»          — идёт запрос;
       • «сообщений пока нет»  — ящик ПУСТ, и это норма, а не поломка;
       • ошибка + «Повторить»  — не загрузилось.
     Молчащая пустая карточка читалась бы как третье, хотя означала бы второе. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mayak_bg_gradient">

    <ScrollView
        android:id="@+id/mayak_messages_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mayak_messages_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Шапка выдвинута на 12dp левее колонки содержимого (это −@dimen/mayak_icon_inset;
                 отрицательное значение ссылкой не запишешь). Зачем: у кнопки «назад» коробка 48dp,
                 а значок внутри 24dp — значок утоплен ровно на 12dp. Без компенсации стрелка стоит
                 правее левого края карточек, которые начинаются прямо под ней, и при переходе с
                 «Настроек» (там шапка накладная и выровнена верно) шапка прыгает (ревизия 21-08). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mayak_messages_back"
                    style="@style/Mayak.Button.Text.Icon48"
                    android:contentDescription="@string/mayak_back"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back"
                    app:iconSize="24dp"
                    app:iconTint="@color/mayak_on_bg" />

                <!-- Автоподбор размера (24→16sp): справа «Обновить», и при крупном системном
                     шрифте (200 %) слову «Сообщения» не хватало ширины — рвалось по буквам
                     на две строки (замер 15-08). При обычном шрифте — max-размер, вид прежний. -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeMaxTextSize="24sp"
                    app:autoSizeStepGranularity="1sp"
                    android:text="@string/mayak_messages_title"
                    android:textAppearance="@style/Mayak.Title"
                    android:textSize="24sp" />

                <!-- Поле СПРАВА нулевое: последний элемент строки обязан кончаться там же, где
                     правый край карточки под ним, иначе шапка выглядит уже экрана. Цель нажатия при
                     этом не страдает — её держат minWidth/minHeight 48dp. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mayak_messages_reload"
                    style="@style/Mayak.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/mayak_touch"
                    android:minHeight="@dimen/mayak_touch"
                    android:paddingStart="@dimen/mayak_space_3"
                    android:paddingEnd="0dp"
                    android:text="@string/mayak_refresh"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Mayak.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/mayak_messages_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/mayak_messages_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Mayak.Tagline"
                        android:textColor="@color/mayak_on_surface_muted"
                        tools:text="Сообщений пока нет." />

                    <!-- «Повторить» показываем ТОЛЬКО при неудачной загрузке. Кнопка на пустом ящике
                         означала бы «попробуйте ещё раз получить пустоту». -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mayak_messages_retry"
                        style="@style/Mayak.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/mayak_support_retry"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Не вошли — читать нечего, но экран не тупик: ведём на вход. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mayak_messages_login"
                style="@style/Mayak.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mayak_sign_in"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
