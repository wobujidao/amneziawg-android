<?xml version="1.0" encoding="utf-8"?>
<!-- Экран блокировки приложения: брендовый градиент, логотип, подпись, кнопки «Разблокировать»/«Выйти».
     Системный BiometricPrompt показывается поверх автоматически (MayakLockActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mayak_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mayak_bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/mayak_screen_h"
        android:paddingEnd="@dimen/mayak_screen_h">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/mayak_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_space_5"
            android:text="@string/mayak_lock_title"
            android:textColor="@color/mayak_on_bg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_space_2"
            android:gravity="center"
            android:text="@string/mayak_lock_subtitle"
            android:textAppearance="@style/Mayak.Tagline"
            android:textColor="@color/mayak_on_bg_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_lock_unlock"
            style="@style/Mayak.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_space_6"
            android:text="@string/mayak_lock_unlock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mayak_lock_exit"
            style="@style/Mayak.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/mayak_space_3"
            android:text="@string/mayak_lock_exit" />
    </LinearLayout>
</FrameLayout>
