<resources xmlns:android="http://schemas.android.com/apk/res/android"
           xmlns:tools="http://schemas.android.com/tools">

    <style name="AmneziaWgTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="AppThemeBase" parent="AmneziaWgTheme">
        <item name="materialCardViewStyle">@style/AmneziaWgTheme.MaterialCardView</item>
        <item name="toolbarStyle">@style/AmneziaWgTheme.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/AmneziaWgTheme.BottomSheetDialog</item>
        <item name="android:statusBarColor">@null</item>
    </style>

    <!-- Various additional API-specific features in values-v*/styles.xml -->
    <style name="AppTheme" parent="AppThemeBase" />

    <style name="AmneziaWgTheme.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <!-- Унифицировано на шкалу «Маяк» (radius.xs): убирает legacy 4dp (см. дизайн-ревью §3.1) -->
        <item name="cornerRadius">@dimen/mayak_radius_xs</item>
        <item name="contentPadding">@dimen/mayak_space_2</item>
    </style>

    <style name="AmneziaWgTheme.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="NoBackgroundTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="TvTheme" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Экран «Маяк»: DayNight — следует светлому/тёмному режиму телефона.
         Фон/статусбар/навбар берутся из семантических цветов (флипаются в values-night). -->
    <style name="MayakTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialCardViewStyle">@style/AmneziaWgTheme.MaterialCardView</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/mayak_bg</item>
        <item name="android:colorBackground">@color/mayak_bg</item>
        <item name="colorSurface">@color/mayak_surface</item>
        <item name="colorOnSurface">@color/mayak_on_surface</item>
        <!-- 🔴 Диалоги и меню Material берут фон НЕ из colorSurface, а из «контейнерных» ролей —
             и без этих строк рисовались стандартным СЕРЫМ поверх нашего тёмно-синего экрана: чужая
             карточка в середине приложения (снято на эмуляторе 17-08 на «Мои устройства», «Сбросить
             настройки», «Выйти» — то есть на всех разом). Правится в теме, а не по месту вызова:
             мест вызова два десятка, и следующий диалог снова родился бы серым. -->
        <item name="colorSurfaceContainer">@color/mayak_surface</item>
        <item name="colorSurfaceContainerLow">@color/mayak_surface</item>
        <item name="colorSurfaceContainerLowest">@color/mayak_surface</item>
        <item name="colorSurfaceContainerHigh">@color/mayak_surface</item>
        <item name="colorSurfaceContainerHighest">@color/mayak_surface</item>
        <!-- Диалоги AppCompat (а ими построены все наши подтверждения) берут фон окна отсюда,
             а не из ролей выше. Без этой пары «Мои устройства» и все вопросы-подтверждения
             оставались серыми. -->
        <item name="android:colorBackgroundFloating">@color/mayak_surface</item>
        <item name="colorBackgroundFloating">@color/mayak_surface</item>
        <!-- Своя тема диалога: только она надёжно перекрашивает окно (см. Mayak.Dialog). -->
        <item name="alertDialogTheme">@style/Mayak.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Mayak.Dialog</item>
        <item name="colorPrimary">@color/mayak_primary</item>
        <item name="colorOnPrimary">@color/mayak_on_primary</item>
        <!-- Панели ПРОЗРАЧНЫЕ, под ними наш собственный фон (градиент/шапка экрана). Так во всех
             версиях Android одно и то же поведение: окно рисуется от края до края, а отступы под
             панели считает код (MayakSystemBars). Раньше здесь стоял непрозрачный mayak_statusbar —
             но с targetSdk 35 Android 15 эти два свойства ИГНОРИРУЕТ (окно всё равно от края до
             края), и получалось два разных экрана: на новых телефонах контент под панелями, на
             старых — под цветной полосой. Цвет и так совпадал с верхом градиента, так что глазами
             разницы нет. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- цвет текста/иконок в диалогах (язык/тема) тоже следует режиму -->
        <item name="android:textColorPrimary">@color/mayak_on_surface</item>
        <item name="android:textColorSecondary">@color/mayak_on_surface_muted</item>
        <!-- Экран запуска (его рисует СИСТЕМА до старта процесса, поэтому наш выбор темы ему ещё
             неизвестен и DayNight-цвет резолвится по режиму ТЕЛЕФОНА). На светлом телефоне это
             давало вспышку кремового фона перед тёмным приложением — замерено на эмуляторе 09-08.
             Цвет тут НАМЕРЕННО фиксированный тёмный, без пары в values-night: умолчание приложения
             тёмное, а кто выбрал светлую — увидит короткий тёмный кадр вместо длинного светлого. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/mayak_splash_bg</item>
    </style>

    <!-- === Брендовые компоненты «Маяк» (цвета семантические → корректный контраст в обоих режимах) === -->

    <style name="Mayak.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/mayak_on_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Mayak.Tagline" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/mayak_on_bg_muted</item>
    </style>

    <style name="Mayak.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/mayak_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Диалоги приложения. Material берёт фон окна диалога из отдельного drawable, а не из
         цветовых ролей, — поэтому перекрашиваем именно окно (mayak_bg_dialog), а роли задаём
         рядом, чтобы текст и кнопки внутри читались на нашем фоне. Заведено 17-08: до этого все
         диалоги приложения были стандартные серые поверх тёмно-синих экранов. -->
    <style name="Mayak.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/mayak_bg_dialog</item>
        <!-- Панель диалога рисует СВОЙ фон поверх окна — прямоугольный. Пока он непрозрачен, скруглённые
             углы нашего окна не видны: гасим панель, углы остаются от mayak_bg_dialog. -->
        <item name="android:colorBackgroundFloating">@android:color/transparent</item>
        <item name="colorBackgroundFloating">@android:color/transparent</item>
        <!-- Радиус угла диалога: Material берёт его отсюда, а не из нашего drawable. -->
        <item name="android:dialogCornerRadius">28dp</item>
        <item name="dialogCornerRadius">28dp</item>
        <item name="colorSurface">@color/mayak_surface</item>
        <item name="colorOnSurface">@color/mayak_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/mayak_on_surface</item>
        <item name="android:textColorPrimary">@color/mayak_on_surface</item>
        <item name="android:textColorSecondary">@color/mayak_on_surface_muted</item>
        <item name="colorPrimary">@color/mayak_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Mayak.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Mayak.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Mayak.Dialog.Button</item>
    </style>

    <!-- Кнопки диалога: цвет наш, минимальная высота — палец. -->
    <style name="Mayak.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/mayak_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Mayak.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cornerRadius">@dimen/mayak_radius_md</item>
        <item name="cardBackgroundColor">@color/mayak_surface</item>
        <item name="cardElevation">@dimen/mayak_space_2</item>
        <item name="contentPadding">@dimen/mayak_space_5</item>
        <!-- Тонкая обводка: в светлой теме прозрачна, в тёмной — контур (карточка не сливается с navy) -->
        <item name="strokeColor">@color/mayak_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Карточка СКЛАДНОГО раздела: те же поля по бокам, но сверху и снизу вдвое меньше. Свёрнутый
         раздел — это строка меню, а не карточка с содержимым: с полными 20dp он занимал 88dp пустоты
         на заголовок в три слова. 12dp + 48dp строки = 72dp, как двухстрочный пункт списка Material. -->
    <style name="Mayak.Card.Section">
        <item name="contentPaddingTop">12dp</item>
        <item name="contentPaddingBottom">12dp</item>
    </style>

    <!-- Заголовок складного раздела настроек: название слева, шеврон справа, вся строка — кнопка.
         Экран настроек был свитком на шесть экранов прокрутки (правка владельца 17-08), теперь
         каждая карточка складывается. parent="" обязателен: имя с точкой иначе наследует
         несуществующий стиль «Mayak» (ошибка AAPT). -->
    <style name="Mayak.SectionHead" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <!-- 48dp — минимальная цель нажатия по Material: строку жмут пальцем, а не курсором. -->
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Mayak.SectionHead.Title" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/Mayak.CardTitle</item>
    </style>

    <!-- Шеврон «вправо», повёрнутый кодом: 90° — раздел свёрнут (смотрит вниз), 270° — раскрыт. -->
    <style name="Mayak.SectionHead.Chevron" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:tint">@color/mayak_outline</item>
        <item name="android:rotation">90</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Строка листа «Подробности подключения»: слева колонка label/value, справа — опц. кнопка копирования.
         parent="" обязателен: имя с точкой иначе наследует несуществующий стиль «Mayak» (ошибка AAPT). -->
    <style name="Mayak.DetailRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Mayak.DetailRow.TextCol" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Mayak.DetailRow.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/mayak_on_bg_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="Mayak.DetailRow.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/mayak_on_bg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Mayak.DetailRow.Value.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Mayak.DetailRow.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/mayak_divider</item>
    </style>

    <style name="Mayak.DetailRow.Copy" parent="">
        <!-- 48dp — палец; значок внутри остаётся 24dp за счёт padding. -->
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:src">@drawable/ic_copy</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/mayak_on_bg_muted</item>
    </style>

    <style name="Mayak.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/mayak_outline</item>
        <item name="hintTextColor">@color/mayak_outline</item>
        <item name="android:textColorHint">@color/mayak_on_surface_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/mayak_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/mayak_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/mayak_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/mayak_radius_sm</item>
        <item name="boxBackgroundColor">@color/mayak_field_bg</item>
        <item name="materialThemeOverlay">@style/Mayak.TextInput.Overlay</item>
    </style>

    <!-- Цвет вводимого текста и курсора в полях (читаемый в обоих режимах).
         🔴 parent ОБЯЗАТЕЛЕН. Без него имя с точкой наследует Mayak.TextInput — то есть в
         materialThemeOverlay уезжает СТИЛЬ ВИДЖЕТА вместо темы-накладки, и Material перестаёт
         рисовать рамку: поле превращается в подчёркнутую строку без коробки (снято живьём 17-08
         на экране «Написать в поддержку» — поле выглядело сломанным рядом с обведёнными кнопками). -->
    <style name="Mayak.TextInput.Overlay" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="colorOnSurface">@color/mayak_field_on</item>
        <item name="android:textColorPrimary">@color/mayak_field_on</item>
        <item name="colorPrimary">@color/mayak_outline</item>
    </style>

    <style name="Mayak.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mayak_primary</item>
        <item name="android:textColor">@color/mayak_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/mayak_radius_sm</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Mayak.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/mayak_outline</item>
        <item name="android:textColor">@color/mayak_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">@dimen/mayak_radius_sm</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Сегмент переключателя темы (Авто/Свет/Тёмная) в MaterialButtonToggleGroup: компактный,
         иконка по центру, без текста. Заменяет вертикальную стопку из трёх RadioButton (экономит ~90dp). -->
    <style name="Mayak.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/mayak_outline</item>
        <item name="iconTint">@color/mayak_on_surface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
        <item name="android:textColor">@color/mayak_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Mayak.Button.Country" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/mayak_field_bg</item>
        <item name="android:textColor">@color/mayak_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="cornerRadius">@dimen/mayak_radius_sm</item>
        <item name="android:minHeight">56dp</item>
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconGravity">end</item>
        <item name="iconTint">@color/mayak_outline</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Mayak.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/mayak_red</item>
        <item name="android:textColor">@color/mayak_red</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">@dimen/mayak_radius_sm</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Иконки-кнопки в шапке (тема/настройки): тинт следует фону -->
    <style name="Mayak.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/mayak_on_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="iconTint">@color/mayak_on_bg</item>
    </style>

    <!-- Кнопка «только значок» размером ровно в палец: 48×48dp.
         Раньше стрелки «назад» на восьми экранах стояли с minWidth/minHeight=0dp и значком 24dp —
         цель нажатия выходила примерно 36×24dp, то есть промахнуться было легко (ревизия 17-08;
         TouchDelegate в коде нигде нет, так что промах был настоящий). Значок центрируется сам:
         текста у кнопки нет, а внутренние отступы обнулены. -->
    <style name="Mayak.Button.Text.Icon48">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
    </style>

    <!-- Переключатель настроек. Материаловский дефолт красил «включено» лавандовым
         (colorPrimaryContainer сборной темы), хотя рядом на том же экране переключатель темы
         обведён фирменным тоном. Задаём цвета явно — и они theme-aware через mayak_outline. -->
    <style name="Mayak.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/mayak_switch_track</item>
        <item name="thumbTint">@color/mayak_switch_thumb</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>
</resources>
