<?xml version="1.0" encoding="utf-8"?>
<!-- Единые токены «Маяк»: шкала радиусов (8/14/20/28) и 8-pt сетка отступов.
     Цель — убрать «почти, но не совсем одинаковые» углы/марджины (см. дизайн-ревью §3.1). -->
<resources>
    <!-- Радиусы (continuous-логика, концентричность: внутренний = внешний − паддинг) -->
    <dimen name="mayak_radius_xs">8dp</dimen>
    <dimen name="mayak_radius_sm">14dp</dimen>
    <dimen name="mayak_radius_md">20dp</dimen>
    <dimen name="mayak_radius_lg">28dp</dimen>

    <!-- 8-pt сетка отступов -->
    <dimen name="mayak_space_1">4dp</dimen>
    <dimen name="mayak_space_2">8dp</dimen>
    <dimen name="mayak_space_3">12dp</dimen>
    <dimen name="mayak_space_4">16dp</dimen>
    <dimen name="mayak_space_5">20dp</dimen>
    <dimen name="mayak_space_6">24dp</dimen>
    <dimen name="mayak_space_7">32dp</dimen>

    <!-- ===== Смысловые имена отступов (ревизия 21-08) =====
         Зачем поверх шкалы ещё один слой: голая шкала отвечает на вопрос «сколько», но не на вопрос
         «сколько ЗДЕСЬ», и каждый экран выбирал заново — отсюда пятнадцать разных зазоров у одного и
         того же стыка «заголовок карточки → текст» и три разных шага между карточками (замер 21-08:
         из 27 наших разметок 20 не брали из шкалы НИ ОДНОГО значения). Новых чисел тут нет — только
         ссылки на существующие space_*, кроме трёх размеров ЭЛЕМЕНТА внизу.
         Правило: в разметке ставим ЭТИ имена, а space_* — только там, где ни одна роль не подходит. -->
    <dimen name="mayak_screen_h">@dimen/mayak_space_5</dimen>       <!-- 20dp: боковое поле ЭКРАНА — по нему стоят края карточек и значки в шапке.
                                                                          ⚠️ У листов и диалогов колонка СВОЯ, 24dp (space_6): так принято в Material,
                                                                          и лист всплывает поверх экрана, а не встык с ним. Главное — что она ОДНА. -->
    <dimen name="mayak_screen_top">@dimen/mayak_space_2</dimen>     <!-- 8dp: верх содержимого ПОД накладной шапкой (высоту статус-бара добавляет код) -->
    <dimen name="mayak_screen_bottom">@dimen/mayak_space_7</dimen>  <!-- 32dp: хвост прокрутки, чтобы последняя кнопка не липла к жестовой полосе -->
    <dimen name="mayak_card_gap">@dimen/mayak_space_3</dimen>       <!-- 12dp: между соседними карточками. Исключение — настройки: там карточка = строка меню, шаг 8dp (обоснование в styles.xml, Mayak.Card.Section) -->
    <dimen name="mayak_card_title_gap">@dimen/mayak_space_2</dimen> <!-- 8dp: заголовок карточки → её текст -->
    <dimen name="mayak_row_v">@dimen/mayak_space_2</dimen>          <!-- 8dp: вертикальные поля строки списка (высоту держит minHeight, это воздух вокруг текста) -->

    <!-- Размеры ЭЛЕМЕНТА, а не отступы: их нельзя менять «на глаз» вместе с сеткой. -->
    <dimen name="mayak_touch">48dp</dimen>       <!-- минимальная цель нажатия (минимум Google; ниже — промахи пальцем) -->
    <dimen name="mayak_icon">24dp</dimen>        <!-- значок в шапке / в строке: шеврон, стрелка «назад», колокольчик -->
    <dimen name="mayak_icon_inset">12dp</dimen>  <!-- (48−24)/2 — на столько значок утоплен внутри коробки Mayak.Button.Text.Icon48.
                                                      Отсюда берётся компенсирующий отступ −12dp у шапок, лежащих ВНУТРИ колонки
                                                      содержимого: без него стрелка «назад» стоит на 12dp правее края карточек под ней. -->

    <!-- Кнопка подключения: сам круг и квадрат вокруг него (в нём живут волны и ореол, поэтому
         он больше круга). Пробовали уменьшить 176→150 / 256→210 ради строк списка — владелец
         вернул прежний размер (04-08): место направлениям даёт не кнопка, а резиновая карточка.
         Квадрат держим на 256: это ход волн от края круга (176/2) наружу, ужать его — обрезать
         анимацию «Подключение…». Радиус волн берётся из mayak_connect_circle кодом. -->
    <dimen name="mayak_connect_circle">176dp</dimen>
    <dimen name="mayak_connect_area">256dp</dimen>

    <!-- МИНИМАЛЬНАЯ высота отсека под карточку стран на главном (портрет). Не «желаемая» — именно
         минимальная: обычно отсек забирает весь остаток экрана (layout_weight=1), а это число он
         показывает ScrollView'у при замере «сколько всего нужно странице».
         Зачем оно вообще: у отсека стояло layout_height="0dp", и в замере с UNSPECIFIED (первый
         проход ScrollView) LinearLayout меряет такого ребёнка как wrap_content — то есть В ВЫСОТУ
         СТРАНИЦЫ попадала ПОЛНАЯ высота карточки со всеми странами. Стоило ей вырасти — страница
         переставала помещаться и начинала прокручиваться ЦЕЛИКОМ, вместо того чтобы ужать список
         (жалоба владельца 20-08: «прокрутки не должно быть, в прокрутке должны быть только страны»).
         Арифметика числа: поля карточки 12+12 + строка заголовка 48 + зазор 8 + две строки-страны
         96 = 176dp. Меньше — карточка перестаёт быть списком; больше — на невысоких экранах страница
         снова начнёт прокручиваться вся (на 360×720dp с трёхкнопочной панелью 180dp не хватало
         ровно 2dp — замер 20-08). -->
    <dimen name="mayak_dirs_slot_min">176dp</dimen>

    <!-- Логотип на экране входа. Вынесен в токен ради АЛЬБОМНОЙ ориентации (values-land): в ней
         экран вдвое ниже, и логотип на 132dp вместе с заголовком съедал его целиком — при первом
         взгляде человек видел маяк и надпись, а формы входа не видел вовсе. Экран прокручивается,
         то есть тупика не было, но «где тут войти» на пустом месте спрашивать не должны. -->
    <dimen name="mayak_login_logo">132dp</dimen>
</resources>
