<!-- Размеры, отличающиеся в АЛЬБОМНОЙ ориентации. Владелец 04-08 просил не трогать размер круга —
     это про ПОРТРЕТ, где кнопка и есть главный элемент экрана и высоты хватает (851dp). В альбоме
     высоты ~393dp, и круг 176dp вместе со статусом, таймером, пингом и сроком доступа в свою
     половину экрана не помещается — правая колонка обрезалась бы. Здесь круг меньше ровно
     настолько, чтобы столбец влезал целиком; ход волн наружу сохранён прежним: (230−150)/2 = 40dp,
     как и в портрете (256−176)/2 = 40dp, поэтому анимация «Подключение…» не обрезается. -->
<resources>
    <dimen name="mayak_connect_circle">130dp</dimen>
    <dimen name="mayak_connect_area">210dp</dimen>

    <!-- Логотип экрана ВХОДА по той же причине: на 132dp он вместе с заголовком съедал альбомный
         экран целиком, и формы не было видно вовсе (проверено на эмуляторе 08-08). -->
    <dimen name="mayak_login_logo">72dp</dimen>
</resources>
