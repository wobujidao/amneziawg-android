<?xml version="1.0" encoding="utf-8"?>
<!-- Плитка «⚡ Рекомендуем» над списком стран (SPEC-0031 T3): те же цвета, что у пилюль-значков
     (лёгкая акцентная заливка), радиус 14dp — как у фона выбранной строки (mayak_row_selected),
     чтобы скругления в карточке не спорили друг с другом.
     ⚠️ ЗДЕСЬ ТОЛЬКО ЗАЛИВКА. Обводка живёт в mayak_fg_recommended_tile и вешается на плитку через
     android:foreground: фон рисуется ПОД детьми, и фон выбранной строки внутри плитки разрывал
     рамку по бокам (скриншот владельца 10-08). Вернёшь stroke сюда — разрыв вернётся. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#0C4FC3F7" />
</shape>
