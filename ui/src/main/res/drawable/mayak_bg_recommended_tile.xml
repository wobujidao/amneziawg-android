<?xml version="1.0" encoding="utf-8"?>
<!-- Плитка «⚡ Рекомендуем» над списком стран (SPEC-0031 T3): те же цвета, что у пилюль-значков
     (лёгкая акцентная заливка + тонкая обводка mayak_bg_ipv6_badge), но радиус 14dp — как у фона
     выбранной строки (mayak_row_selected), чтобы скругления в карточке не спорили друг с другом.
     Обводка полупрозрачная: плитка должна выделяться, но не кричать громче кнопки подключения. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="#124FC3F7" />
    <stroke android:width="1dp" android:color="#664FC3F7" />
</shape>
