<!-- Фон окна диалога «Маяк». Заведён 17-08: диалоги приложения (вопросы-подтверждения, «Мои
     устройства», выбор языка и значка) рисовались стандартным СЕРЫМ поверх нашего тёмно-синего
     экрана — чужая карточка в середине приложения. Через цветовые роли Material это не правилось:
     фон окна диалога берётся из отдельного drawable, поэтому drawable теперь свой.
     Радиус 28dp — размер угла диалога по Material 3; обводка та же, что у карточек. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mayak_surface" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/mayak_card_stroke" />
</shape>
