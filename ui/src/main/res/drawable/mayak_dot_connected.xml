<?xml version="1.0" encoding="utf-8"?>
<!-- Точка «через эту страну идёт трафик прямо сейчас». Зелёная — тот же цвет, что у хорошего пинга
     (mayak_ping_green), чтобы в строке не заводить третий смысловой цвет. Маленькая и без текста:
     подпись «Подключено» в строке списка занимала бы место названия страны на узких экранах.
     Смысл различать: выбранная строка подсвечена и когда туннель ВЫКЛЮЧЕН — по подсветке нельзя было
     понять, идёт трафик или нет (пункт бэклога «выбрана И подключена»). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/mayak_ping_green" />
    <size android:width="8dp" android:height="8dp" />
</shape>
