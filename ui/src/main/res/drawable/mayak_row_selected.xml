<?xml version="1.0" encoding="utf-8"?>
<!-- Фон ВЫБРАННОЙ строки-страны: тональная заливка + левый акцентный маркер (Happ-стиль).
     Маркер раньше был полосой во всю высоту строки с радиусом 14dp на пятидюймовой ширине 5dp:
     скругление такого радиуса на такой ширине вырождается, полоса выходила клином и не совпадала
     со скруглённым углом самой заливки — на стыке оставался заметный «зазубренный» уголок
     (замечание владельца 04-08 со скриншотом). Теперь маркер — аккуратная «пилюля» ВНУТРИ заливки:
     отступ слева, отступ сверху/снизу, своё маленькое скругление. С углом заливки он больше не спорит. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mayak_row_selected_bg" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:gravity="start|center_vertical"
        android:start="6dp"
        android:top="9dp"
        android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mayak_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
