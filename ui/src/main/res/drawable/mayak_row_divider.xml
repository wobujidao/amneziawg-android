<?xml version="1.0" encoding="utf-8"?>
<!-- Тонкий разделитель между строками стран (showDividers="middle" у mayak_dirs_container).
     Раньше линия шла от края до края контейнера и потому ТОРЧАЛА за скруглённым углом подсветки
     выбранной строки — было видно на скриншоте (замечание владельца 04-08). Теперь линия утоплена
     по краям ровно на внутреннее поле строки (mayak_country_row, paddingStart/End = space_3):
     она начинается и кончается там же, где ТЕКСТ строки, и с округлением больше не спорит.
     ⚠️ Это НЕ «граница подсветки», как тут было написано раньше: подсветка выбранной строки
     (mayak_row_selected) вешается кодом фоном, а фон рисуется во всю ширину view — padding его не
     сжимает. То есть линия короче подсветки на 12dp с каждой стороны, и это осознанно: сравнивать
     её надо с текстом, а не с заливкой (ревизия 21-08, B5). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/mayak_space_3"
    android:insetRight="@dimen/mayak_space_3">
    <shape android:shape="rectangle">
        <size android:height="1dp" />
        <solid android:color="@color/mayak_divider" />
    </shape>
</inset>
