<?xml version="1.0" encoding="utf-8"?>
<!-- ОБВОДКА плитки «⚡ Рекомендуем» — отдельным ресурсом и через android:foreground, а не в фоне.
     Причина: фон View рисуется ПОД детьми, а внутрь плитки код кладёт обычную строку-страну. Когда
     рекомендованная страна ещё и выбрана, её фон (mayak_row_selected — заливка во всю ширину)
     закрашивает обводку слева и справа ровно на высоту строки: рамка выглядит разорванной сверху и
     снизу от строки (скриншот владельца 10-08). Передний план рисуется ПОВЕРХ детей, поэтому рамка
     остаётся целой и при этом ничего не сдвигается — выравнивание строки со списком не меняется. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/mayak_radius_sm" />
    <stroke android:width="1dp" android:color="#264FC3F7" />
    <solid android:color="@android:color/transparent" />
</shape>
