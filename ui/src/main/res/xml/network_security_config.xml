<?xml version="1.0" encoding="utf-8"?>
<!--
  Доверие к нашему серверному сертификату ядра «Маяк». Ядро держит TLS-серт, выпущенный НАШИМ CA
  (cmd/mayak-ca), а не публичным — поэтому телефон должен доверять нашему CA для адреса ядра.
  В приложение зашит только ПУБЛИЧНЫЙ сертификат CA (res/raw/mayak_ca.pem) — это не секрет.
  Приватный ключ CA остаётся на сервере и в приложение/репо НЕ попадает.
-->
<network-security-config>
    <!-- По умолчанию: только TLS (без cleartext), системные корни. Под это попадает публичный
         домен api.mayakvpn.ru с обычным сертификатом Let's Encrypt — спец-настройки не нужны. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 🔴 IP-ФОЛБЭК СНЯТ 19-08 (аудит, A4). Здесь стоял 138.16.128.138 с доверием ДЕВ-CA. Этот
         адрес — БОЕВАЯ нода ru1 (российский выход и вход транзита), а не дев-ядро: дев-ядро
         (45.132.18.167) убрали 03-08 по тому же поводу, а этот адрес заменил его 18-07, когда
         дев-контур ещё был жив. Контур снят 07-08 — доверять дев-CA по адресу живой боевой машины
         теперь не за чем и опасно по привычке.
         Этот файл в сборки для людей НЕ попадает вовсе: prodRelease перекрывает его своим
         (ui/src/prodRelease/res/xml/network_security_config.xml, там свой прод-CA и адрес ядра).
         Осталось поведение по умолчанию: только TLS, только системные корни. -->
</network-security-config>
